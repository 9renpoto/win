{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["$app/types", "node", "vite/client"]
  },
  "include": ["src", "scripts", "__tests__", "*.ts"],
  "exclude": ["node_modules", ".svelte-kit", "coverage"]
}
