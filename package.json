{
  "name": "win",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "content:generate": "node scripts/generate-content.ts",
    "predev": "npm run content:generate",
    "dev": "vite --host 127.0.0.1",
    "start": "npm run dev",
    "prebuild": "npm run content:generate",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "pretest": "npm run content:generate",
    "test": "node --import ./scripts/register-svelte-tests.ts --test \"__tests__/utils/*.test.ts\" \"__tests__/routes/*.test.ts\" \"__tests__/components/*.test.ts\"",
    "test:coverage": "node scripts/test-coverage.ts",
    "test:browser": "node scripts/run-browser-tests.ts",
    "algolia:sync": "node scripts/sync_algolia_index.ts",
    "deploy": "npm run build && wrangler deploy",
    "precheck": "npm run content:generate",
    "pretest:coverage": "npm run content:generate",
    "pretest:browser": "npm run build",
    "check:biome": "biome ci .",
    "textlint": "textlint",
    "lint:text": "textlint \"posts/{2021,2023,2024,2025,2026}/**/*.md\""
  },
  "dependencies": {
    "algoliasearch": "^5.57.0",
    "marked": "^18.0.12",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0",
    "textlint": "^15.2.2",
    "textlint-filter-rule-comments": "^1.2.2",
    "textlint-rule-incremental-headers": "^0.2.0",
    "textlint-rule-ja-no-mixed-period": "^3.0.1",
    "textlint-rule-ja-no-successive-word": "^2.0.1",
    "textlint-rule-ja-no-weak-phrase": "^2.0.0",
    "textlint-rule-max-ten": "^5.0.0",
    "textlint-rule-no-dead-link": "^6.0.1",
    "textlint-rule-no-double-negative-ja": "^2.0.1",
    "textlint-rule-no-doubled-conjunction": "^3.0.0",
    "textlint-rule-no-doubled-conjunctive-particle-ga": "^3.0.0",
    "textlint-rule-no-doubled-joshi": "^5.1.0",
    "textlint-rule-no-dropping-the-ra": "^3.0.0",
    "textlint-rule-no-hankaku-kana": "^2.0.1",
    "textlint-rule-no-mix-dearu-desumasu": "^6.0.4",
    "textlint-rule-no-nfd": "^2.0.2",
    "textlint-rule-preset-ja-spacing": "^3.0.3",
    "textlint-rule-preset-jtf-style": "^3.0.2"
  }
}
